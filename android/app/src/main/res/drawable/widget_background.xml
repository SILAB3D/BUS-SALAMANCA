<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo de la caja entera del widget.

    Degradado en vez de un color plano: el widget se apoya sobre el fondo de
    pantalla, que puede ser cualquier cosa, y un tono que se oscurece hacia
    abajo lo separa de lo que tenga detras sin necesidad de una sombra (los
    widgets no las tienen: se recortan al borde de la celda).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/widget_surface"
        android:endColor="@color/widget_surface_alt" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/widget_border" />
</shape>
