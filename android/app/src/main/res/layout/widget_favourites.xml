<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget de paradas favoritas.

    Las filas NO estan escritas aqui: se anaden en tiempo de ejecucion a
    `widget_rows` con RemoteViews.addView(), porque cuantas caben depende del
    tamano al que se haya estirado el widget y eso solo se sabe en
    FavouritesWidget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!--
        Cabecera. FavouritesWidget la oculta cuando quitarla deja sitio para
        una parada guardada mas: una parada vale mas que el titulo.
    -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp">

        <!--
            El autobus hace de logo: el widget se ve entre los de otras apps y
            «Mis paradas» a solas no dice de cual es.
        -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_bus" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="@color/widget_brand"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!--
        Contenedor de las paradas.

        Ocupa el hueco entero y las filas que se le anaden llevan peso 1 cada
        una, asi que se reparten todo el alto: con una parada guardada en un
        widget de cuatro, esa parada ocupa el widget entero (y con letra mas
        grande) en vez de quedarse arriba con tres huecos vacios debajo. Cuando
        no hay paradas se oculta desde FavouritesWidget y el hueco pasa entero
        al mensaje de abajo.

        Arranca oculto por lo mismo que el mensaje arranca visible: este archivo
        es tambien el `previewLayout`, y sin paradas que pintar lo que tiene que
        verse en el selector del lanzador es el mensaje, centrado.
    -->
    <LinearLayout
        android:id="@+id/widget_rows"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <!--
        Sin paradas guardadas no hay nada que pulsar: se explica que hacer.

        Arranca VISIBLE porque este mismo archivo es el `initialLayout` y el
        `previewLayout` del widget: en el selector del lanzador, y en el hueco
        que queda mientras se pinta por primera vez, un widget en blanco no
        dice nada de lo que hace.
    -->
    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginBottom="6dp"
            android:alpha="0.45"
            android:contentDescription="@null"
            android:src="@drawable/widget_bus" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/widget_empty"
            android:textColor="@color/widget_text_soft"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>
</LinearLayout>
